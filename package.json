{
  "name": "@mapapp/media-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "载荷媒体与图像流播放模块（多路同屏 / 图像流序列帧 / 归一化叠加层）：独立构建、独立示例、独立验收",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.demo.json && tsc --noEmit -p tsconfig.probe.json",
    "build": "npm run build:lib && npm run build:demo && npm run build:probe",
    "build:lib": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "build:probe": "vite build --config vite.probe.config.ts",
    "gen:assets": "node scripts/gen-placeholder-assets.mjs",
    "dev": "vite --config vite.demo.config.ts",
    "preview": "vite preview --config vite.demo.config.ts",
    "test": "node tests/unit-test.mjs",
    "test:decode": "node examples/decode-probe.mjs --require",
    "test:runtime": "node examples/runtime-probe.mjs --require",
    "accept": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/acceptance.ps1"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
